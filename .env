# Copy this file to .env in the project root and adjust values as needed.
# .env is gitignored — never commit real credentials.

# --- PostgreSQL ---
POSTGRES_USER=rie_dev
POSTGRES_PASSWORD=rie_dev_password
POSTGRES_DB=repository_intelligence
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Redis ---
REDIS_PORT=6379
REDIS_HOST=localhost

# --- Application ---
LOG_LEVEL=INFO
ENVIRONMENT=development
