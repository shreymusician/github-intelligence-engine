# Copy this file to .env in the project root and adjust values as needed.
# .env is gitignored — never commit real credentials.

# --- PostgreSQL ---
# Values match what docker-compose.yml / scripts/init-postgres.sql actually
# provision (repo_user / ai_analytics). Previously this file had drifted to
# unrelated values (rie_dev / repository_intelligence) that don't exist in
# the container, and used the wrong variable name (POSTGRES_PASSWORD instead
# of POSTGRES_USER_PASSWORD, which is what alembic/env.py reads).
POSTGRES_USER=repo_user
POSTGRES_USER_PASSWORD=repo_password
POSTGRES_DB=ai_analytics
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Redis ---
REDIS_PORT=6379
REDIS_HOST=localhost

# --- Application ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- GitHub API (Checkpoint 1.1.a) ---
# Replace with a real PAT (read-only scope) before running the GitHub client.
GITHUB_TOKEN=placeholder_replace_with_real_token
