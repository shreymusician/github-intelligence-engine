# Environment Variables for Repository Intelligence Engine
#
# This file defines all configuration for local development.
#
# IMPORTANT:
# - NEVER commit actual secrets to this repository
# - Copy this file to .env (git-ignored) and modify for your environment
# - .env.example serves as documentation and default values
#
# Security Principle:
# - Development passwords are not secrets (not for production)
# - This file is for LOCAL development only
# - Production will use secret management (Vault, AWS Secrets Manager, etc.)

# ============================================================================
# PostgreSQL Configuration
# ============================================================================

# PostgreSQL Admin Password
# Role: Super-user account for database administration
# Default: safe for local development
# CHANGE: Not needed for local dev (default acceptable)
POSTGRES_ADMIN_PASSWORD=postgres_admin

# PostgreSQL Application User Password
# Role: Non-superuser account used by application
# Default: safe for local development
# CHANGE: Not needed for local dev (default acceptable)
POSTGRES_USER_PASSWORD=repo_password

# PostgreSQL Port (external - on host machine)
# Default: 5432 (standard PostgreSQL port)
# CHANGE: Only if port already in use on your machine
POSTGRES_PORT=5432

# PostgreSQL Maximum Connections
# Purpose: Limit concurrent connections (prevent resource exhaustion)
# Default: 200 (reasonable for local dev, handles 10+ developers)
# CHANGE: Increase if adding many test connections
POSTGRES_MAX_CONNECTIONS=200

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis Port (external - on host machine)
# Default: 6379 (standard Redis port)
# CHANGE: Only if port already in use on your machine
REDIS_PORT=6379

# Redis Max Memory Policy
# Options: allkeys-lru, volatile-lru, allkeys-ttl, etc.
# Purpose: What happens when Redis memory is full
# Default: volatile-lru (remove oldest TTL keys first)
# CHANGE: Only if custom eviction policy needed
REDIS_MAXMEMORY_POLICY=volatile-lru

# ============================================================================
# pgAdmin Configuration
# ============================================================================

# pgAdmin Admin Email
# Role: Login email for pgAdmin web interface
# Default: admin@admin.com
# CHANGE: Use your email for personal setup
PGADMIN_EMAIL=admin@admin.com

# pgAdmin Admin Password
# Purpose: Login password for web interface
# Default: admin (safe for local development)
# CHANGE: Use something stronger if working with sensitive data
PGADMIN_PASSWORD=admin

# pgAdmin Port (external - on host machine)
# Default: 5050 (non-standard to avoid conflicts)
# CHANGE: Only if port already in use on your machine
PGADMIN_PORT=5050

# ============================================================================
# Application Configuration
# ============================================================================

# Application Environment
# Options: development, staging, production
# Default: development (enables debug logging, hot reload)
# CHANGE: Only change for testing staging/production setup
APP_ENV=development

# Application Debug Mode
# Options: true, false
# Default: true (verbose logging, detailed error messages)
# CHANGE: false only when testing quiet mode
APP_DEBUG=true

# Application Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: DEBUG (capture everything during development)
# CHANGE: WARNING or ERROR to reduce log verbosity
APP_LOG_LEVEL=DEBUG

# ============================================================================
# GitHub API Configuration
# ============================================================================

# GitHub API Rate Limit
# Purpose: Number of API requests per hour
# Default: 60 (unauthenticated) or 5000 (authenticated)
# CHANGE: Only if using personal token
GITHUB_API_RATE_LIMIT=60

# GitHub Personal Access Token (optional)
# Purpose: Increase rate limit to 5000 requests/hour
# Default: (empty - uses unauthenticated rate limit)
# CHANGE: Paste your GitHub token here for higher limits
# How to create: https://github.com/settings/tokens
# DO NOT commit this file with your real token
GITHUB_API_TOKEN=

# ============================================================================
# Data Collection Configuration
# ============================================================================

# Repository Sample Size
# Purpose: How many repositories to initially collect
# Default: 100 (good for testing, completes quickly)
# CHANGE: 1000 for more realistic data, 10 for quick testing
INITIAL_REPO_COUNT=100

# Analysis Depth
# Options: metadata, content, code
# Default: metadata (fast, sufficient for MVP)
# CHANGE: content for deeper analysis, code for research
ANALYSIS_DEPTH=metadata

# ============================================================================
# Feature Flags
# ============================================================================

# Enable Vector Search
# Purpose: Enable pgvector for semantic search
# Default: true (installed in database)
# CHANGE: false if having issues with pgvector
ENABLE_VECTOR_SEARCH=true

# Enable Full-Text Search
# Purpose: Enable PostgreSQL full-text search capabilities
# Default: true (standard PostgreSQL feature)
# CHANGE: false to disable (not recommended)
ENABLE_FTS=true

# ============================================================================
# Monitoring & Observability
# ============================================================================

# Enable Structured Logging
# Purpose: Output logs in JSON format (easy to parse)
# Default: false (human-readable text)
# CHANGE: true for production-like testing
STRUCTURED_LOGGING=false

# Enable Performance Monitoring
# Purpose: Track query times, function times
# Default: true (helps identify slow operations)
# CHANGE: false only if causing performance issues
ENABLE_PERFORMANCE_MONITORING=true

# ============================================================================
# Notes for Developers
# ============================================================================
#
# HOW TO USE THIS FILE:
# 1. Copy this file to .env (it's git-ignored)
# 2. Modify values as needed for your setup
# 3. Docker Compose will automatically read .env
# 4. Values in .env override defaults in docker-compose.yml
#
# TESTING DIFFERENT CONFIGURATIONS:
# - Create .env.test for test environment
# - Create .env.staging for staging environment
# - Use: docker compose --env-file .env.test up
#
# ACCESSING SERVICES:
# - PostgreSQL: localhost:5432 (inside Docker: postgres:5432)
# - Redis: localhost:6379 (inside Docker: redis:6379)
# - pgAdmin: http://localhost:5050 (use PGADMIN_EMAIL and PGADMIN_PASSWORD)
#
# DEFAULT CREDENTIALS (LOCAL DEVELOPMENT ONLY):
# PostgreSQL Admin: postgres / postgres_admin
# PostgreSQL App User: repo_user / repo_password
# pgAdmin: admin@admin.com / admin
#
# SECURITY:
# These defaults are ONLY safe for local development
# NEVER use these in production
# Production uses secret management (AWS Secrets Manager, HashiCorp Vault, etc.)
