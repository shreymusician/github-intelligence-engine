# ============================================================================
# ENVIRONMENT & SECRETS
# ============================================================================
# NEVER commit actual secrets or .env files with real credentials
#
# NOTE: every pattern below previously had an inline trailing "# comment"
# on the same line (e.g. ".env    # Actual environment variables"). Gitignore
# syntax does not support inline comments - "#" is only a comment when it is
# the first character of a line - so each pattern was silently matching a
# literal filename containing "#" and spaces, never the real file. Fixed as
# part of the Checkpoint 1.1 security history rewrite (2026-08-06); verified
# with `git check-ignore -v` after the fix.
# Actual environment variables (local only)
.env
# Alternative local env file
.env.local
# Environment-specific local files
.env.*.local
# Private keys
*.pem
*.key
# Local secrets file
secrets.json
# Personal access token scratch files (found tracked pre-.gitignore; untracked in Checkpoint 1.1.d cleanup)
PAT*.txt

# ============================================================================
# PYTHON
# ============================================================================
__pycache__/
*.py[cod]               # .pyc, .pyo, .pyd
*$py.class
*.so
*.egg
*.egg-info/
.eggs/

# Virtual environments (each developer has their own)
venv/
.venv/
env/
ENV/
.env/
virtualenv/

# Build artifacts
build/
dist/
*.egg-info/
pip-log.txt
pip-delete-this-directory.txt

# Compiler/formatter caches
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================================================
# TESTING & COVERAGE
# ============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
.coverage.xml
coverage.xml

# ============================================================================
# DATA & ARTIFACTS (NOT COMMITTED)
# ============================================================================
# Raw/processed data, models, cache - generated locally, not shared
data/*
!data/.gitkeep
!data/README.md

notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints/

# Trained models (too large to commit)
*.pkl
*.pickle
*.joblib
*.h5
*.pth
*.pt

# Cache files
*.cache
.cache/

# ============================================================================
# LOGS & TEMPORARY FILES
# ============================================================================
*.log
logs/
*.tmp
*.temp
*.swp
*~
.~lock*

# ============================================================================
# IDE & EDITOR
# ============================================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm/IntelliJ
.idea/
*.iml
*.iws
out/

# Sublime
*.sublime-project
*.sublime-workspace

# Vim/Neovim
.vim/
*.vim
.nvimrc

# General
*.swp
*.swo
*~
.DS_Store

# ============================================================================
# OS-SPECIFIC
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory

# ============================================================================
# DOCKER
# ============================================================================
# Docker volumes are managed by Docker daemon, not git
# Data persists in named volumes, not in repo filesystem
.dockerignore is maintained separately

# Local Docker artifacts
.docker/

# ============================================================================
# DOCUMENTATION BUILDS
# ============================================================================
docs/_build/
site/

# ============================================================================
# MISC
# ============================================================================
# Backups
*.bak
*.backup
*.orig

# OS-generated backups
*~

# Notes/scratch
notes/
scratch/
TODO.txt
