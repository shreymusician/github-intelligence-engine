# ============================================================================
# ENVIRONMENT & SECRETS
# ============================================================================
# NEVER commit actual secrets or .env files with real credentials
.env                      # Actual environment variables (local only)
.env.local               # Alternative local env file
.env.*.local             # Environment-specific local files
*.pem                    # Private keys
*.key                    # Private keys
secrets.json            # Local secrets file
PAT*.txt                # Personal access token scratch files (found tracked pre-.gitignore; untracked in Checkpoint 1.1.d cleanup)

# ============================================================================
# PYTHON
# ============================================================================
__pycache__/
*.py[cod]               # .pyc, .pyo, .pyd
*$py.class
*.so
*.egg
*.egg-info/
.eggs/

# Virtual environments (each developer has their own)
venv/
.venv/
env/
ENV/
.env/
virtualenv/

# Build artifacts
build/
dist/
*.egg-info/
pip-log.txt
pip-delete-this-directory.txt

# Compiler/formatter caches
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================================================
# TESTING & COVERAGE
# ============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
.coverage.xml
coverage.xml

# ============================================================================
# DATA & ARTIFACTS (NOT COMMITTED)
# ============================================================================
# Raw/processed data, models, cache - generated locally, not shared
data/*
!data/.gitkeep
!data/README.md

notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints/

# Trained models (too large to commit)
*.pkl
*.pickle
*.joblib
*.h5
*.pth
*.pt

# Cache files
*.cache
.cache/

# ============================================================================
# LOGS & TEMPORARY FILES
# ============================================================================
*.log
logs/
*.tmp
*.temp
*.swp
*~
.~lock*

# ============================================================================
# IDE & EDITOR
# ============================================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm/IntelliJ
.idea/
*.iml
*.iws
out/

# Sublime
*.sublime-project
*.sublime-workspace

# Vim/Neovim
.vim/
*.vim
.nvimrc

# General
*.swp
*.swo
*~
.DS_Store

# ============================================================================
# OS-SPECIFIC
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory

# ============================================================================
# DOCKER
# ============================================================================
# Docker volumes are managed by Docker daemon, not git
# Data persists in named volumes, not in repo filesystem
.dockerignore is maintained separately

# Local Docker artifacts
.docker/

# ============================================================================
# DOCUMENTATION BUILDS
# ============================================================================
docs/_build/
site/

# ============================================================================
# MISC
# ============================================================================
# Backups
*.bak
*.backup
*.orig

# OS-generated backups
*~

# Notes/scratch
notes/
scratch/
TODO.txt
